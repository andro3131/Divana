---
import { useTranslations, type Locale } from '../../i18n/ui';
import { sectionIds, getLocalizedPath } from '../../i18n/utils';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = sectionIds.danceEvenings[locale];
const reservePath = locale === 'sl' ? '/rezervacija' : '/en/reservation';
---

<section id={sectionId} class="py-24 px-4 md:px-8 bg-dark-900">
  <div class="max-w-5xl mx-auto">
    <SectionHeading title={t('danceEvenings.title')} subtitle={t('danceEvenings.subtitle')} />

    <div class="max-w-3xl mx-auto text-center mb-16" data-animate>
      <p class="text-dark-200 text-lg leading-relaxed italic">
        &ldquo;{t('danceEvenings.description')}&rdquo;
      </p>
    </div>

    <!-- Dance evening atmosphere image -->
    <div class="dance-evening-img max-w-4xl mx-auto mb-16 rounded-2xl overflow-hidden border border-dark-700/30" data-animate>
      <img
        src="https://divana-cdn.b-cdn.net/PONUDBA/Dvorana_plesni_pari_v_ozadju_d01d3806c9.jpeg"
        alt={locale === 'sl' ? 'Plesni večer' : 'Dance evening'}
        class="w-full object-cover"
        loading="lazy"
      />
    </div>

    <!-- Events loaded via client-side fetch -->
    <div id="events-container" data-animate>
      <h3 class="text-lg text-dark-300 text-center mb-8 tracking-wider uppercase">{t('danceEvenings.upcoming')}</h3>

      <!-- Koncertni plakat (ležeči) — se sam skrije po datumu v data-until -->
      <div id="concert-poster" data-until="2026-11-18T00:00:00+01:00" class="poster-float mb-8">
      <a
        id="concert-poster-link"
        href="/plakati/trebnje-2026-11-17-lezeci.jpg"
        class="block rounded-2xl overflow-hidden border border-gold/30 hover:border-gold/60 shadow-xl shadow-black/40 transition-all duration-300"
        title={locale === 'sl' ? 'Odpri plakat' : 'Open poster'}
      >
        <picture>
          <source srcset="/plakati/trebnje-2026-11-17-lezeci.webp" type="image/webp" />
          <img
            src="/plakati/trebnje-2026-11-17-lezeci.jpg"
            alt={locale === 'sl'
              ? 'Koncert: Maja Marinčič z bendom – V trenutku, 17. november 2026 ob 18. uri, Kulturni dom Trebnje. Vstop prost.'
              : 'Concert: Maja Marinčič with band – V trenutku, 17 November 2026 at 6 pm, Kulturni dom Trebnje. Free entry.'}
            width="1800"
            height="1012"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
      </div>

      <div id="events-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Loading skeleton -->
        <div class="event-skeleton bg-dark-800/50 border border-dark-700/50 rounded-2xl p-6 animate-pulse">
          <div class="h-6 bg-dark-700 rounded w-3/4 mb-4"></div>
          <div class="h-4 bg-dark-700 rounded w-1/2 mb-2"></div>
          <div class="h-4 bg-dark-700 rounded w-2/3 mb-2"></div>
          <div class="h-4 bg-dark-700 rounded w-1/3"></div>
        </div>
      </div>
      <p id="no-events" class="hidden text-center text-dark-400 py-8 max-w-lg mx-auto leading-relaxed">
        {locale === 'sl' ? 'Trenutno ni razpisanih dogodkov.' : 'No upcoming events at the moment.'}
        <br/><span class="text-dark-500 text-sm">{t('danceEvenings.noEventsNote')}</span>
      </p>
    </div>
  </div>
</section>

<!-- Modal za koncertni plakat -->
<div id="poster-modal" class="fixed inset-0 z-[100] hidden bg-dark-950/95 backdrop-blur-md" role="dialog" aria-modal="true">
  <button id="poster-modal-close" class="absolute top-4 right-4 z-10 text-white/70 hover:text-white transition-colors p-2" aria-label={locale === 'sl' ? 'Zapri' : 'Close'}>
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <div class="poster-modal-inner flex items-center justify-center h-full p-4 md:p-12">
    <picture class="contents">
      <!-- Na telefonu pokončna različica, ki bolje zapolni zaslon -->
      <source media="(max-width: 767px)" srcset="/plakati/trebnje-2026-11-17.jpg" />
      <img
        src="/plakati/trebnje-2026-11-17-lezeci.jpg"
        alt={locale === 'sl' ? 'Koncertni plakat – Trebnje, 17. 11. 2026' : 'Concert poster – Trebnje, 17 Nov 2026'}
        class="max-w-full max-h-full object-contain rounded-lg shadow-2xl"
        loading="lazy"
      />
    </picture>
  </div>
</div>

<style>
  /* Rahlo nihanje gor-dol (kot plakat v heroju) */
  @keyframes posterFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .poster-float { animation: posterFloat 4.8s ease-in-out 0.8s infinite; }
</style>

<script>
  // Klik na ležeči plakat odpre modal namesto nove strani
  const modal = document.getElementById('poster-modal');
  const link = document.getElementById('concert-poster-link');
  const closeBtn = document.getElementById('poster-modal-close');

  function openModal() {
    modal?.classList.remove('hidden');
    document.body.classList.add('lightbox-open');
  }
  function closeModal() {
    modal?.classList.add('hidden');
    document.body.classList.remove('lightbox-open');
  }

  link?.addEventListener('click', (e) => {
    e.preventDefault();
    openModal();
  });
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === modal || t.classList.contains('poster-modal-inner')) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) closeModal();
  });
</script>

<script define:vars={{ locale, reservePath }}>
  // Koncertni plakat: po izteku datuma ga skrij
  const poster = document.getElementById('concert-poster');
  const posterActive = !!poster && new Date() < new Date(poster.dataset.until);
  if (poster && !posterActive) poster.remove();

  async function loadEvents() {
    try {
      const res = await fetch('/api/events');
      if (!res.ok) throw new Error('Failed to fetch');
      const events = await res.json();
      const grid = document.getElementById('events-grid');
      const noEvents = document.getElementById('no-events');

      // Remove skeleton
      document.querySelectorAll('.event-skeleton').forEach(el => el.remove());

      if (events.length === 0) {
        if (!posterActive) noEvents?.classList.remove('hidden');
        grid?.classList.add('hidden');
        return;
      }

      const titleKey = locale === 'sl' ? 'titleSl' : 'titleEn';
      const soldOutText = locale === 'sl' ? 'Razprodano' : 'Sold out';
      const reserveText = locale === 'sl' ? 'Rezerviraj mesto' : 'Reserve a spot';
      const perPairText = locale === 'sl' ? 'na par' : 'per couple';

      events.forEach(event => {
        const isSoldOut = event.remainingCapacity <= 0;
        const dateStr = new Intl.DateTimeFormat(locale === 'sl' ? 'sl-SI' : 'en-GB', {
          dateStyle: 'long',
          timeStyle: 'short',
        }).format(new Date(event.date));

        const spotsText = locale === 'sl'
          ? `Še ${event.remainingCapacity} prostih mest`
          : `${event.remainingCapacity} spots remaining`;

        const card = document.createElement('div');
        card.className = 'bg-dark-800/50 border border-dark-700/50 rounded-2xl p-6 hover:border-gold/30 transition-all duration-300';
        card.innerHTML = `
          <h3 class="text-xl font-heading font-semibold text-dark-50 mb-3">${event[titleKey] || event.titleSl}</h3>
          <div class="space-y-2 text-dark-300 text-sm mb-5">
            <p>${dateStr}</p>
            <p>${event.location}</p>
            ${event.price ? `<p>${(event.price / 100).toFixed(0)}&euro; ${perPairText}</p>` : ''}
          </div>
          <div class="flex items-center justify-between">
            ${isSoldOut
              ? `<span class="text-red-400 font-semibold text-sm">${soldOutText}</span>`
              : `<span class="text-primary-400 text-sm font-medium">${spotsText}</span>
                 <a href="${reservePath}/${event.id}" class="inline-flex items-center px-5 py-2 bg-gradient-to-r from-primary-400 to-primary-600 text-dark-950 font-medium text-sm rounded-lg hover:from-primary-300 hover:to-primary-500 transition-all duration-300">${reserveText}</a>`
            }
          </div>
        `;
        grid?.appendChild(card);
      });
    } catch (e) {
      document.querySelectorAll('.event-skeleton').forEach(el => el.remove());
      const noEvents = document.getElementById('no-events');
      if (!posterActive) noEvents?.classList.remove('hidden');
    }
  }

  loadEvents();
</script>
