---
import { type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;

const alt = locale === 'sl'
  ? 'Plakat: Maja Marinčič z bendom – V trenutku, 17. november 2026 ob 18. uri, Kulturni dom Trebnje'
  : 'Poster: Maja Marinčič with band – V trenutku, 17 November 2026 at 6 pm, Kulturni dom Trebnje';
const title = locale === 'sl' ? 'Odpri plakat' : 'Open poster';
---

<div class="teaser-float">
  <div class="banner-wrapper">
    <a class="poster-card" href="/plakati/trebnje-2026-11-17.jpg" target="_blank" rel="noopener" title={title}>
      <picture>
        <source srcset="/plakati/trebnje-2026-11-17.webp" type="image/webp" />
        <img
          src="/plakati/trebnje-2026-11-17.jpg"
          alt={alt}
          width="1131"
          height="1600"
          loading="eager"
          decoding="async"
        />
      </picture>
    </a>
    <div class="novo-badge">NOVO</div>
  </div>
</div>

<style>
  /* Rahlo lebdenje gor-dol */
  @keyframes teaserFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .teaser-float { animation: teaserFloat 4.8s ease-in-out 0.8s infinite; }

  /* Pokončni plakat (razmerje 1448 × 2048) */
  .banner-wrapper {
    position: relative;
    height: min(66vh, 600px);
    aspect-ratio: 1448 / 2048;
  }

  .poster-card {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    overflow: hidden;
    border: 1.5px solid rgba(201, 162, 78, 0.55);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55), 0 0 0 4px rgba(18, 14, 10, 0.35);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .poster-card:hover {
    transform: translateY(-2px) scale(1.015);
    border-color: #E2C77A;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.6), 0 0 24px rgba(201, 162, 78, 0.25);
  }

  .poster-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .novo-badge {
    position: absolute;
    top: 17%;
    right: -18px;
    width: clamp(44px, 6vw, 60px);
    height: clamp(44px, 6vw, 60px);
    border-radius: 50%;
    background: radial-gradient(circle at 45% 40%, #E74C3C, #9B2335);
    color: #fff;
    font-weight: 900;
    font-family: 'Playfair Display', serif;
    letter-spacing: 0.06em;
    font-size: clamp(10px, 1.8vw, 13px);
    display: flex; align-items: center; justify-content: center;
    transform: rotate(10deg);
    box-shadow: 0 4px 18px rgba(192, 57, 43, 0.45);
    pointer-events: none;
  }
</style>
